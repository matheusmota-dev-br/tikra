{
  "name": "@mathlabs/tikra",
  "version": "1.2.1",
  "description": "TikZ and pgfplots figures to SVG and PNG, without a TeX install. Math labels typeset by mathra. Runs on WebAssembly in Node, bundlers and browsers.",
  "keywords": [
    "tikz",
    "pgfplots",
    "latex",
    "svg",
    "png",
    "figures",
    "diagrams",
    "plots",
    "webassembly",
    "rust",
    "python",
    "cli",
    "javascript",
    "typescript"
  ],
  "homepage": "https://matheusmota-dev-br.github.io/tikra/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusmota-dev-br/tikra.git",
    "directory": "npm"
  },
  "bugs": "https://github.com/matheusmota-dev-br/tikra/issues",
  "license": "(MIT OR Apache-2.0) AND OFL-1.1 AND LicenseRef-GUST-Font-License",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./index.d.ts",
          "default": "./node/index.mjs"
        },
        "require": {
          "types": "./index.d.cts",
          "default": "./node/index.cjs"
        }
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./web/index.js"
      }
    },
    "./tikra.wasm": "./tikra.wasm",
    "./package.json": "./package.json"
  },
  "main": "./node/index.cjs",
  "module": "./web/index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "web",
    "node",
    "tikra.wasm",
    "index.d.ts",
    "index.d.cts",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "OFL-STIXTwoMath.txt",
    "GUST-FONT-LICENSE-LatinModernMath.txt"
  ]
}